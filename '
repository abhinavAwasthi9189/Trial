use bevy::prelude::*;

#[derive(Component)]
struct Person;

#[derive(Component)]
struct Name(String);

fn main(){
    //app is our container/ the game object. it is what the game is inside of.
    //ECS-entity component system[for each object you give its properties seprately from a curated set

    App::new().add_systems(Startup,add_people)
        .add_systems(Update,(first,hello)).run();
    //adds_system adds systems to our apps schedule(a set of systems,metadata& exectuotors that are
    //run in a certain sequence().
    //we can also add methods like .before/.after(system/function) and it will run it before/after that.
    //(put all functions inside of the second arguement to run them all)
    
    //Startup only runs once so use it for things like spawning
    //Update clocks in 60fps. so it is used for things like keyboard input,etc.
}

fn first(){println!("hakuna matata");}
fn second(){println!("hakuna");}
fn third(){println!("matata");}
fn add_people(mut commands: Commands) {
    commands.spawn((Person, Name("Miri".to_string())));
    commands.spawn((Person, Name("Siya".to_string())));
    commands.spawn((Person, Name("Shreya".to_string())));
}

fn hello(query:Query<&Name, With<Person>>){
    for i in query{println!("{i.Name}")}
